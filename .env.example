# ==============================================================================
# SALESTORM ARFA: Production-Grade Environment Configuration
# Copy this file to .env before starting the platform: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Runtime & Ports
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090

# ------------------------------------------------------------------------------
# 2. Redis 7.2 Single-Threaded Core (Atomic Lua Reservation Barrier)
# ------------------------------------------------------------------------------
# Use 'redis' inside Docker compose network; use 'localhost' when connecting from host
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_MEMORY=2gb
REDIS_MAX_MEMORY_POLICY=noeviction
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 System of Record & Transactional Outbox
# Configured with wal_level=logical for Debezium Change Data Capture (CDC)
# ------------------------------------------------------------------------------
# Use 'postgres' inside Docker compose network; use 'localhost' when connecting from host
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=salestorm_core
POSTGRES_USER=salestorm_admin
POSTGRES_PASSWORD=salestorm_secure_password
POSTGRES_WAL_LEVEL=logical
POSTGRES_MAX_WAL_SENDERS=10
POSTGRES_MAX_REPLICATION_SLOTS=10
POSTGRES_MAX_POOL_SIZE=50
POSTGRES_IDLE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 4. Apache Kafka (Confluent KRaft Mode - Zero ZooKeeper)
# ------------------------------------------------------------------------------
# External broker URL (Host access): localhost:9092
# Internal broker URL (Container network): kafka:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_HOST_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_CLIENT_ID=salestorm-producer
KAFKA_GROUP_ID=salestorm-order-consumers

# Kafka Event Topics (Auto-created on boot)
KAFKA_TOPIC_PAYMENTS=payment.captured.v1
KAFKA_TOPIC_ORDERS=orders.lifecycle.v1

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 6. Flash Sale Invariants & Security
# ------------------------------------------------------------------------------
SALESTORM_SECRET_KEY=salestorm_super_secure_key_2026
TOTAL_INITIAL_STOCK=100
LEASE_DURATION_SECONDS=300
PRODUCT_ID=flash_sku_titanium_01
MAX_UNITS_PER_USER=1

# ------------------------------------------------------------------------------
# 7. Live Cloud Infrastructure Probes
# ------------------------------------------------------------------------------
CLOUDFLARE_EDGE_URL=https://1.1.1.1/cdn-cgi/trace
STRIPE_GATEWAY_URL=https://api.stripe.com/healthcheck
AWS_CLOUD_URL=https://httpbin.org/status/200

# ------------------------------------------------------------------------------
# 8. Observability & Telemetry
# ------------------------------------------------------------------------------
LOG_LEVEL=info
PROMETHEUS_METRICS_PATH=/metrics
